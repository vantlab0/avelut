{
  "appId": "com.avelut.app",
  "appName": "AVELUT",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#000000",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK",
      "resizeOnFullScreen": false
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "statsUrl": ""
    },
    "GoogleSignIn": {
      "clientId": "750743868519-fhhpqa43j11uuu61kj5d7oni141vscu8.apps.googleusercontent.com"
    }
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#000000"
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#FFFFFF"
  },
  "server": {
    "androidScheme": "https",
    "cleartext": false
  }
}

{
  "installCommand": "pnpm install --no-frozen-lockfile",
  "rewrites": [
    {
      "source": "/api/paystack-initialize",
      "destination": "/api/paystack?action=initialize"
    },
    {
      "source": "/api/paystack-verify",
      "destination": "/api/paystack?action=verify"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/((?!api/|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ]
}


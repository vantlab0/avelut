# Server-only provider keys. Never prefix these with VITE_ or expose them to the browser.

# Alibaba / DashScope — preferred: store the key in Supabase `api_keys`
# (provider = 'alibaba', is_active = true; see supabase/api_keys_table.sql).
# The env key below is only a fallback when the DB row is missing or unavailable.
ALIBABA_API_KEY=your_alibaba_api_key_here
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Vector & Voice configurations
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=avelut-textbooks

# Real web search (Tavily). Server-only.
TAVILY_API_KEY=your_tavily_api_key_here
